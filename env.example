# Zabbix Agentic RAG — 환경 변수 예시 (복사 후 .env 로 저장하거나 systemd EnvironmentFile 로 주입)
# 배포 서버: 192.168.6.24, 애플리케이션 루트: /app/rag/fastapi

# --- 경로 ---
APP_ROOT=/app/rag/fastapi
SYNC_LOG_DIR=/app/rag/fastapi/sync

# --- RAG DB (pgvector) ---
# Docker Compose에서 DATABASE_URL 을 넣으면 아래 RAG_DB_* 보다 우선합니다.
# 예: postgresql://rag_user:rag_password@pgvector:5432/rag_db
# DATABASE_URL=

RAG_DB_HOST=127.0.0.1
RAG_DB_PORT=5432
RAG_DB_NAME=rag_db
RAG_DB_USER=rag_user
RAG_DB_PASSWORD=change-me
# 동일 RAG DB 내 테이블 분리: 대화 이력=chat_sessions/chat_messages, 운영 레포트=operational_reports

# --- Zabbix 동기화용 DB (읽기 전용 연결 권장) ---
# Docker(zabbix-net) 안에서 기본 호스트는 postgres-server, DB명 zabbix_70 (/.dockerenv 감지 시)
ZABBIX_DB_HOST=127.0.0.1
ZABBIX_DB_PORT=5432
ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=change-me

# --- Ollama (임베딩) ---
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text-v2-moe
VECTOR_DIMENSION=768

# --- OpenAI (채팅/에이전트) ---
OPENAI_API_KEY=
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# --- LLM 기본값 (UI 및 비에이전트 경로) — 선택지: gpt-5.3-chat-latest, qwen2.5:7b ---
LLM_MODEL=gpt-5.3-chat-latest
# --- 에이전트 전용 (미설정 시 gpt-5.3-chat-latest) ---
# AGENT_MODEL=gpt-5.3-chat-latest
# run_agent: 도구 루프·최종 답 모두 사용자 선택 모델(예: gpt-5.3-chat-latest)로 통일

# AGENT_ENABLED=true
# AGENT_MAX_ITERATIONS_OPENAI=8

# --- 동기화 주기 힌트(문서/세션용, scheduler.py 내부 값과 맞출 것) ---
# RAG_EMBED_SYNC_INTERVAL_HOURS=2
# RAG_CHUNK_SYNC_INTERVAL_HOURS=1

# --- 질의응답 테스트·게이트 (운영/스테이징 공통 스크립트) ---
# TEST_ENV=staging
# TEST_API_BASE_URL=http://127.0.0.1:8000
#   스테이징/운영 중 **하나의 URL만** 지정 (자동 전환 없음)
#   배포 후: python scripts/check_env_gates.py --base-url http://<호스트>:8000
# RAG 검색 품질 배치: TEST_API_BASE_URL 동일 키 사용 (sync/test_search_quality.py)
# API 통합 스모크(게이트·선택 검색·채팅 SSE): python scripts/api_smoke_chat.py --with-search
# 상세: docs/API_QA_TESTING.md
# Agent E2E (실 LLM): RUN_AGENT_E2E=1 pytest tests/test_agent_e2e.py --run-integration -q
# pytest integration 전체: pytest tests/ --run-integration -q
# 품질 트리아지 요약: python scripts/aggregate_quality_metrics.py
# 채팅 10질의 점검(실 LLM): python scripts/qa_10_eval.py --base-url http://127.0.0.1:8000
#   산출물: artifacts/qa10_chat_report.json, artifacts/qa10_operational_report.md
#   서버 cron 예시: scripts/cron_qa10_example.sh
# QA10_BASE_URL=   # 미설정 시 TEST_API_BASE_URL 또는 127.0.0.1:8000 (qa_10_eval.py)
# QA10_DELAY_SEC=2 # 질의 간 대기

# --- 192.168.6.24 배포 참고 ---
# 개발 PC(Windows): 저장소 루트에서 .\scripts\deploy_to_192.ps1 — 소스 동기화 + docker restart rag-fastapi
# 애플리케이션 루트에 소스 배치 후:
#   export PYTHONPATH=/app/rag/fastapi
#   pip install -r requirements.txt
#   # API
#   uvicorn app.main:app --host 0.0.0.0 --port 8000
#   # 임베딩 스케줄러 (별도 프로세스)
#   cd /app/rag/fastapi && PYTHONPATH=/app/rag/fastapi python -m sync.scheduler
